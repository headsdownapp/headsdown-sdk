{
  "name": "@headsdown/sdk",
  "version": "0.8.0",
  "description": "TypeScript client SDK for the HeadsDown availability API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./schemas/local-session-summary.schema.json": "./schemas/local-session-summary.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.mjs'",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.mjs'",
    "schema:sync": "node scripts/schema-sync.mjs",
    "codegen:types": "node scripts/codegen-types.mjs",
    "codegen": "npm run codegen:types",
    "preversion": "git diff --exit-code CHANGELOG.md && (echo 'Error: Update CHANGELOG.md before bumping version' && exit 1) || exit 0",
    "version": "node scripts/update-changelog.mjs && git add CHANGELOG.md",
    "prepare": "npm run build",
    "emit:local-session-summary-schema": "node scripts/emit-local-session-summary-schema.mjs",
    "prepublishOnly": "npm run build && npm run emit:local-session-summary-schema",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "headsdown",
    "availability",
    "focus",
    "sdk",
    "ai-agent",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/headsdownapp/headsdown-sdk.git"
  },
  "homepage": "https://github.com/headsdownapp/headsdown-sdk#readme",
  "bugs": {
    "url": "https://github.com/headsdownapp/headsdown-sdk/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/typescript": "^6.0.0",
    "@graphql-codegen/typescript-operations": "^6.0.0",
    "@types/node": "^24.0.0",
    "graphql": "^16.13.2",
    "json-schema-to-ts": "^3.1.1",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
