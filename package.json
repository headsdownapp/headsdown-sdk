{
  "name": "@headsdown/sdk",
  "version": "0.2.6",
  "description": "TypeScript client SDK for the HeadsDown availability API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.mjs'",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.mjs'",
    "schema:sync": "node scripts/schema-sync.mjs",
    "codegen:types": "node scripts/codegen-types.mjs",
    "codegen": "npm run codegen:types",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "headsdown",
    "availability",
    "focus",
    "sdk",
    "ai-agent",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/headsdownapp/headsdown-sdk.git"
  },
  "homepage": "https://github.com/headsdownapp/headsdown-sdk#readme",
  "bugs": {
    "url": "https://github.com/headsdownapp/headsdown-sdk/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/typescript": "^5.0.9",
    "@graphql-codegen/typescript-operations": "^5.0.9",
    "@types/node": "^20.17.0",
    "graphql": "^16.13.2",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
